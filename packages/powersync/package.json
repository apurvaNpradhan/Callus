  "devDependencies": {
    "@callus/config": "workspace:*",
    "@powersync/node": "^1.0.1",
    "@types/node": "catalog:",
    "better-sqlite3": "^12.11.1",
    "dotenv": "catalog:",
    "tsx": "^4.23.13",
    "typescript": "catalog:"
  }
